}

model Outlet {
  id          Int        @id @default(autoincrement())
  name        String
  code        String     @unique
  type        OutletType
  description String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  menuItems   MenuItem[]
  orders      PosOrder[]

  @@index([type])
  @@index([isActive])
  @@map("outlets")
}

model MenuItem {
  id          Int            @id @default(autoincrement())
  outletId    Int
  name        String
  code        String
  category    String?
  description String?
  price       Decimal        @db.Decimal(12, 2)
  status      MenuItemStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
