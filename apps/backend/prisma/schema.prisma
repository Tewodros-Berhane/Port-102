  order            PosOrder         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  recordedBy       User?            @relation("PosOrderPaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([method])
  @@index([recordedAt])
