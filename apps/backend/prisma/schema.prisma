generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RoleKey {
  HOTEL_OWNER
  HOTEL_ADMIN
  GENERAL_MANAGER
  FRONT_DESK_CASHIER
  HOUSEKEEPING_SUPERVISOR
  HOUSEKEEPING_ATTENDANT
  MAINTENANCE_SUPERVISOR
  MAINTENANCE_TECHNICIAN
  ACCOUNTANT
  RESTAURANT_CASHIER
  WAITER
  STOREKEEPER
  PROCUREMENT_OFFICER
  HR_ADMIN
  GUEST
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
  PASSWORD_RESET_REQUIRED
}

enum HotelStatus {
  ACTIVE
  INACTIVE
}

enum HotelUserStatus {
  ACTIVE
  INACTIVE
  INVITED
}

enum RefreshTokenStatus {
  ACTIVE
  REVOKED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum GuestStatus {
  ACTIVE
  INACTIVE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalRequestType {
  LARGE_DISCOUNT
  REFUND
  INVENTORY_ADJUSTMENT
  PURCHASE_REQUEST
  PURCHASE_ORDER
  ROOM_OUT_OF_ORDER
}

model User {
  id                        Int               @id @default(autoincrement())
  email                     String            @unique
  passwordHash              String
  fullName                  String
  phone                     String?
  status                    UserStatus        @default(ACTIVE)
  tokenVersion              Int               @default(0)
  lastLoginAt               DateTime?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  hotelUsers                HotelUser[]
  refreshTokens             RefreshToken[]
  employees                 Employee[]
  guests                    Guest[]
  auditLogs                 AuditLog[]        @relation("AuditActor")
  requestedApprovalRequests ApprovalRequest[] @relation("ApprovalRequester")
  approvedApprovalRequests  ApprovalRequest[] @relation("ApprovalApprover")

  @@map("users")
}

model Hotel {
  id               Int               @id @default(autoincrement())
  name             String
  code             String            @unique
  status           HotelStatus       @default(ACTIVE)
  timezone         String            @default("Africa/Nairobi")
  defaultCurrency  String            @default("ETB")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  memberships      HotelUser[]
  roles            Role[]
  departments      Department[]
  employees        Employee[]
  guests           Guest[]
  auditLogs        AuditLog[]
  approvalRequests ApprovalRequest[]

  @@map("hotels")
}

model HotelUser {
  id                        Int               @id @default(autoincrement())
  userId                    Int
  hotelId                   Int
  roleId                    Int
  departmentId              Int?
  status                    HotelUserStatus   @default(ACTIVE)
  joinedAt                  DateTime          @default(now())
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  user                      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel                     Hotel             @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  role                      Role              @relation(fields: [roleId], references: [id], onDelete: Restrict)
  department                Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  refreshTokens             RefreshToken[]
  auditLogs                 AuditLog[]        @relation("AuditActorMembership")
  requestedApprovalRequests ApprovalRequest[] @relation("ApprovalRequesterMembership")
  approvedApprovalRequests  ApprovalRequest[] @relation("ApprovalApproverMembership")

  @@unique([userId, hotelId])
  @@index([hotelId, status])
  @@index([roleId])
  @@index([departmentId])
  @@map("hotel_users")
}

model Role {
  id          Int              @id @default(autoincrement())
  hotelId     Int?
  key         String
  systemKey   RoleKey?         @unique
  name        String
  description String?
  isSystem    Boolean          @default(false)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  hotel       Hotel?           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  memberships HotelUser[]
  permissions RolePermission[]

  @@unique([hotelId, key])
  @@index([hotelId, isActive])
  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  key         String           @unique
  name        String
  category    String
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@index([category])
  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id          Int                @id @default(autoincrement())
  userId      Int
  hotelUserId Int?
  tokenHash   String             @unique
  status      RefreshTokenStatus @default(ACTIVE)
  expiresAt   DateTime
  revokedAt   DateTime?
  createdByIp String?
  revokedByIp String?
  userAgent   String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotelUser   HotelUser?         @relation(fields: [hotelUserId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([hotelUserId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Department {
  id          Int         @id @default(autoincrement())
  hotelId     Int
  key         String
  name        String
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  hotel       Hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  memberships HotelUser[]
  employees   Employee[]

  @@unique([hotelId, key])
  @@index([hotelId, isActive])
  @@map("departments")
}

model Employee {
  id             Int            @id @default(autoincrement())
  hotelId        Int
  departmentId   Int?
  userId         Int?
  employeeNumber String?
  firstName      String
  lastName       String
  email          String?
  phone          String?
  jobTitle       String?
  status         EmployeeStatus @default(ACTIVE)
  hireDate       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  hotel          Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  department     Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([hotelId, employeeNumber])
  @@unique([hotelId, userId])
  @@index([hotelId, status])
  @@index([departmentId])
  @@map("employees")
}

model Guest {
  id             Int         @id @default(autoincrement())
  hotelId        Int
  userId         Int?
  firstName      String
  lastName       String
  email          String?
  phone          String?
  nationality    String?
  documentNumber String?
  status         GuestStatus @default(ACTIVE)
  preferences    Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  hotel          Hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([hotelId, email])
  @@unique([hotelId, userId])
  @@index([hotelId, status])
  @@index([hotelId, lastName])
  @@map("guests")
}

model AuditLog {
  id               Int        @id @default(autoincrement())
  hotelId          Int?
  actorUserId      Int?
  actorHotelUserId Int?
  action           String
  entityType       String?
  entityId         String?
  ipAddress        String?
  userAgent        String?
  metadata         Json?
  createdAt        DateTime   @default(now())
  hotel            Hotel?     @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  actorUser        User?      @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorHotelUser   HotelUser? @relation("AuditActorMembership", fields: [actorHotelUserId], references: [id], onDelete: SetNull)

  @@index([hotelId, createdAt])
  @@index([actorUserId])
  @@index([action])
  @@map("audit_logs")
}

model ApprovalRequest {
  id                     Int                 @id @default(autoincrement())
  hotelId                Int
  requestedByUserId      Int
  requestedByHotelUserId Int?
  decidedByUserId        Int?
  decidedByHotelUserId   Int?
  type                   ApprovalRequestType
  status                 ApprovalStatus      @default(PENDING)
  title                  String
  reason                 String?
  payload                Json?
  decisionNote           String?
  decidedAt              DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  hotel                  Hotel               @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  requestedByUser        User                @relation("ApprovalRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  requestedByHotelUser   HotelUser?          @relation("ApprovalRequesterMembership", fields: [requestedByHotelUserId], references: [id], onDelete: SetNull)
  decidedByUser          User?               @relation("ApprovalApprover", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  decidedByHotelUser     HotelUser?          @relation("ApprovalApproverMembership", fields: [decidedByHotelUserId], references: [id], onDelete: SetNull)

  @@index([hotelId, status])
  @@index([requestedByUserId])
  @@index([decidedByUserId])
  @@index([type])
  @@map("approval_requests")
}
