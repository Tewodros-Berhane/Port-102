{
  "name": "port-102",
  "version": "0.1.0",
  "private": true,
  "description": "Hotel operating system monorepo.",
  "workspaces": [
    "apps/backend",
    "apps/frontend",
    "apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "backend:build": "npm run build -w @port-102/backend",
    "backend:dev": "npm run start:dev -w @port-102/backend",
    "backend:start": "npm run start -w @port-102/backend",
    "backend:test": "npm run test -w @port-102/backend",
    "backend:prisma:generate": "npm run prisma:generate -w @port-102/backend",
    "backend:prisma:migrate": "npm run prisma:migrate -w @port-102/backend",
    "backend:prisma:deploy": "npm run prisma:deploy -w @port-102/backend",
    "backend:prisma:studio": "npm run prisma:studio -w @port-102/backend",
    "backend:prisma:seed": "npm run prisma:seed -w @port-102/backend"
  },
  "engines": {
    "node": ">=22"
  }
}
